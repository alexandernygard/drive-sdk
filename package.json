{
  "name": "@alexandernygard/drive",
  "version": "0.2.1",
  "description": "Client for Nyggis Drive: open, create and share documents from word2, xl2 and ppt2, plus the shared React pieces (share dialog, avatars, file icons).",
  "type": "module",
  "license": "MIT",
  "author": "Alexander Nygård",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandernygard/drive-sdk.git"
  },
  "homepage": "https://drive.nyggis.com",
  "keywords": [
    "drive",
    "documents",
    "sharing",
    "collaboration",
    "react"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@alexandernygard/components": ">=0.1.4",
    "lucide-react": ">=1",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@alexandernygard/components": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@alexandernygard/components": "^0.5.0",
    "@changesets/cli": "^3.0.3",
    "@types/react": "^19.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
